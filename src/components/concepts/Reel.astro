---
import { asset } from "../../lib/urls";

interface Props {
  class?: string;
}
const { class: klass = "" } = Astro.props;
const poster = asset("/media/hero-poster.webp");
const src = asset("/media/hero-reel.mp4");
---

<div class:list={["reel", klass]}>
  <img
    src={poster}
    alt="Drone view over the North Saskatchewan River and a community gathering in Edmonton"
    width="1280"
    height="720"
  />
  <video
    muted
    loop
    playsinline
    preload="none"
    poster={poster}
    data-src={src}
    aria-hidden="true"
  ></video>
</div>

<script>
  const clips = document.querySelectorAll<HTMLVideoElement>("video[data-src]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const saveData = connection?.saveData === true;
  if (reduce || saveData) {
    clips.forEach((clip) => clip.remove());
  } else {
    const start = () => {
      clips.forEach((clip) => {
        const source = clip.dataset.src;
        if (source && clip.getAttribute("src") == null) clip.src = source;
        void clip.play().catch(() => undefined);
      });
    };
    window.addEventListener("load", () => {
      window.setTimeout(start, 400);
    });
  }
</script>
