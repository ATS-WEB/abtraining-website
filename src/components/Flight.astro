---
import { asset, page } from "../lib/urls";

const stops = [
  {
    kicker: "Keepers of the Land",
    title: "Fly the river and the prairie.",
    text: "A 100% Indigenous owned and operated academy. Edmonton and Maskwacis. ATS with HK Drone Service.",
    image: "/media/aerial-river.webp",
    alt: "Drone view of the North Saskatchewan River and the Edmonton river valley",
    href: "/indigenous-relations/",
    link: "Land, data, environment",
  },
  {
    kicker: "Community",
    title: "People on the ground.",
    text: "500+ students from Indigenous communities, government, and industry. 25+ Indigenous communities served.",
    image: "/media/aerial-gathering.webp",
    alt: "Drone view of a community gathering on a field beside the river",
    href: "/voices/",
    link: "Hear from students",
  },
  {
    kicker: "01 · Ground school",
    title: "Learn the rules before you leave the ground.",
    text: "Transport Canada Basic and Advanced exam preparation. Basic online is open for checkout.",
    image: "/media/ground-school.webp",
    alt: "An instructor teaching an RPAS ground school class",
    href: "/training/drone-pilot-certificate-basic-online/",
    link: "Basic ground school",
  },
  {
    kicker: "02 · Flight review",
    title: "Then you fly.",
    text: "In-person flight reviews for Advanced and Complex certificates. Aircraft can be provided.",
    image: "/media/flight-line.webp",
    alt: "Pilots with controllers beside a multirotor on a marked pad",
    href: "/training/flight-review-advanced-and-complex/",
    link: "Flight review",
  },
  {
    kicker: "03 · Applied skills",
    title: "Survey, LiDAR, methane.",
    text: "Mapping, environmental monitoring, greenhouse gas, and search work for the land you come from.",
    image: "/media/field-winter.webp",
    alt: "Students and instructors preparing a multirotor on a winter prairie",
    href: "/training/",
    link: "Application courses",
  },
  {
    kicker: "04 · Careers and Nations",
    title: "Skills that stay home.",
    text: "First Nation programs, capacity building, and drone services with HK. Leaders, jobs, and self-determination.",
    image: "/media/community-crew.webp",
    alt: "A training group posed with a mapping drone",
    href: "/services/#communities",
    link: "Community programs",
  },
];
---

<section class="flight" data-flight data-mode="static" id="flight" aria-label="A flight over the academy pathway">
  <a class="flight-skip" href="#quiz">Skip the flight</a>
  <p class="flight-leg" data-leg aria-live="polite">Leg 1 of {stops.length}. Scroll to fly.</p>
  <div class="flight-pin">
    {
      stops.map((stop, index) => (
        <article class="flight-card" data-index={index}>
          <img src={asset(stop.image)} alt={stop.alt} width="1400" height="788" fetchpriority={index === 0 ? "high" : undefined} />
          <div class="flight-copy">
            <p class="flight-kicker">{stop.kicker}</p>
            <h2>{stop.title}</h2>
            <p>{stop.text}</p>
            <a href={page(stop.href)}>{stop.link}</a>
          </div>
        </article>
      ))
    }
    <video
      class="flight-video"
      data-src={asset("/media/hero-reel.mp4")}
      poster={asset("/media/hero-poster.webp")}
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-flight]");
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const slow = connection?.saveData === true || connection?.effectiveType === "slow-2g" || connection?.effectiveType === "2g";
    const cards = [...root.querySelectorAll<HTMLElement>(".flight-card")];
    const leg = root.querySelector<HTMLElement>("[data-leg]");
    const video = root.querySelector<HTMLVideoElement>(".flight-video");

    const show = (index: number) => {
      cards.forEach((card, i) => {
        const on = i === index;
        card.classList.toggle("is-on", on);
        card.toggleAttribute("hidden", !on);
      });
      if (leg) {
        const title = cards[index]?.querySelector("h2")?.textContent ?? "";
        leg.textContent = `Leg ${index + 1} of ${cards.length}. ${title}`;
      }
    };

    if (reduce || slow) {
      cards.forEach((card) => card.removeAttribute("hidden"));
      if (video) video.remove();
      if (leg) leg.textContent = "The flight is shown as separate scenes.";
    } else {
      root.dataset.mode = "live";
      if (video?.dataset.src) video.src = video.dataset.src;
      let ticking = false;
      const update = () => {
        const total = root.offsetHeight - window.innerHeight;
        const y = Math.min(Math.max(-root.getBoundingClientRect().top, 0), Math.max(total, 1));
        const progress = total > 0 ? y / total : 0;
        const scaled = progress * cards.length;
        const index = Math.min(cards.length - 1, Math.floor(scaled));
        const local = scaled - index;
        show(index);
        const active = cards[index];
        const image = active?.querySelector("img");
        if (image) {
          image.style.transform = `scale(${1.12 - local * 0.08})`;
        }
        if (video && index === 0 && video.readyState >= 1 && Number.isFinite(video.duration)) {
          const target = Math.min(video.duration - 0.05, local * video.duration);
          if (Math.abs(video.currentTime - target) > 0.12) video.currentTime = target;
        }
        if (video) video.style.opacity = index === 0 ? "1" : "0";
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      update();
    }
  }
</script>
