---
import { mediaSlot, type MediaId } from "../data/home-media";
import { asset, page } from "../lib/urls";

interface Stop {
  kicker: string;
  title: string;
  hero?: boolean;
  text: string;
  photos: readonly MediaId[];
  href: string;
  link: string;
}

const stops: readonly Stop[] = [
  {
    kicker: "Keepers of the Land",
    title: "A 100% Indigenous owned and operated RPAS Academy",
    hero: true,
    text: "See your land from the sky.",
    photos: ["survey-oblique"],
    href: "/indigenous-relations/",
    link: "Land, data, environment",
  },
  {
    kicker: "It starts here",
    title: "People on the ground.",
    text: "More than 500 students have trained with us, from Indigenous communities, government, and industry. We have served more than 25 Indigenous communities.",
    photos: ["graduates-field", "graduates-aircraft", "class-group"],
    href: "/voices/",
    link: "Hear from students",
  },
  {
    kicker: "Ground school",
    title: "Learn the rules before you leave the ground.",
    text: "Transport Canada Basic, Advanced, and Complex. You can start Basic and Advanced online.",
    photos: ["ground-school", "classroom"],
    href: "/training/drone-pilot-certificate-basic-online/",
    link: "Basic ground school",
  },
  {
    kicker: "Flight review",
    title: "Then you fly.",
    text: "In-person flight reviews for Advanced and Complex. We can provide the aircraft.",
    photos: ["flight-line", "winter-flight", "gym-practice", "heavy-lift"],
    href: "/training/flight-review-advanced-and-complex/",
    link: "Flight review",
  },
  {
    kicker: "Applied skills",
    title: "Then you work the land.",
    text: "Survey, LiDAR, and methane. Mapping, environmental monitoring, greenhouse gas, and search, for the land you come from.",
    photos: ["survey-nadir", "thermal-solar"],
    href: "/training/",
    link: "Application courses",
  },
  {
    kicker: "Careers and Nations",
    title: "Then you bring it home.",
    text: "First Nation programs, capacity building, and drone services with HK, from Edmonton and Maskwacis. Leaders, jobs, and self-determination.",
    photos: ["field-crew", "field-team", "indoor-group"],
    href: "/services/#communities",
    link: "Community programs",
  },
];

function still(id: MediaId) {
  const item = mediaSlot(id);
  if (!item.src || item.width === null || item.height === null) {
    throw new Error(`Flight still is missing a file: ${id}`);
  }
  const srcset = (kind: "avif" | "webp") =>
    item.variants.map((variant) => `${asset(variant[kind])} ${variant.width}w`).join(", ");
  return {
    alt: item.alt,
    focus: item.focus,
    width: item.width,
    height: item.height,
    src: asset(item.src),
    avif: srcset("avif"),
    webp: srcset("webp"),
  };
}
---

<section class="flight" data-flight data-mode="static" id="flight" aria-label="A flight over the academy pathway">
  <a class="flight-skip" href="#quiz">Skip the flight</a>
  <p class="flight-leg" data-leg aria-live="polite">
    <span data-leg-count>Leg 1 of {stops.length}</span><span class="flight-leg-name" data-leg-name>. Scroll to fly.</span>
  </p>
  <div class="flight-pin">
    {
      stops.map((stop, index) => (
        <article class:list={["flight-card", stop.hero && "is-hero"]} data-index={index}>
          {stop.photos.map((id, photoIndex) => {
            const photo = still(id);
            const eager = index === 0 && photoIndex === 0;
            return (
              <picture class="flight-plate" hidden={photoIndex > 0 ? true : undefined}>
                <source type="image/avif" srcset={photo.avif} sizes="100vw" />
                <source type="image/webp" srcset={photo.webp} sizes="100vw" />
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  style={`object-position: ${photo.focus}`}
                  fetchpriority={eager ? "high" : undefined}
                  decoding={eager ? "sync" : "async"}
                />
              </picture>
            );
          })}
          <div class="flight-copy">
            <p class="flight-kicker">{stop.kicker}</p>
            {stop.hero ? (
              <h1>
                A <span class="flight-accent">100% Indigenous</span> owned and operated RPAS Academy
              </h1>
            ) : (
              <h2>{stop.title}</h2>
            )}
            {stop.hero && <p class="flight-sub">Indigenous-led. Sky-ready.</p>}
            <p>{stop.text}</p>
            <a href={page(stop.href)}>{stop.link}</a>
          </div>
        </article>
      ))
    }
    <video
      class="flight-video"
      data-src={asset("/media/hero-reel.mp4")}
      poster={asset("/media/hero-poster.webp")}
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
    <div class="flight-shade" aria-hidden="true"></div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-flight]");
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const slow = connection?.saveData === true || connection?.effectiveType === "slow-2g" || connection?.effectiveType === "2g";
    const cards = [...root.querySelectorAll<HTMLElement>(".flight-card")];
    const leg = root.querySelector<HTMLElement>("[data-leg]");
    const video = root.querySelector<HTMLVideoElement>(".flight-video");

    const showLeg = (index: number) => {
      if (!leg) return;
      const count = leg.querySelector("[data-leg-count]");
      const name = leg.querySelector("[data-leg-name]");
      const card = cards[index];
      const heading = card?.querySelector("h1, h2");
      const kicker = card?.querySelector(".flight-kicker")?.textContent?.replace(/\s+/g, " ").trim() ?? "";
      const title =
        heading?.tagName === "H1" ? kicker : (heading?.textContent?.replace(/\s+/g, " ").trim() ?? "");
      if (count) count.textContent = `Leg ${index + 1} of ${cards.length}`;
      if (name) name.textContent = title ? `. ${title}` : "";
    };

    if (reduce || slow) {
      cards.forEach((card) => {
        card.removeAttribute("hidden");
        card.querySelectorAll<HTMLElement>(".flight-plate").forEach((plate, plateIndex) => {
          if (plateIndex === 0) plate.removeAttribute("hidden");
          else plate.setAttribute("hidden", "");
        });
      });
      if (video) video.remove();
      root.querySelector(".flight-shade")?.remove();
      if (leg) {
        const count = leg.querySelector("[data-leg-count]");
        const name = leg.querySelector("[data-leg-name]");
        if (count) count.textContent = "The flight is shown as separate scenes.";
        if (name) name.textContent = "";
      }
    } else {
      root.dataset.mode = "live";
      if (video?.dataset.src) video.src = video.dataset.src;

      const weights = cards.map((card, index) => {
        const photos = Math.max(1, card.querySelectorAll(".flight-plate").length);
        return index === 0 ? Math.max(photos, 2) : photos;
      });
      const total = weights.reduce((sum, weight) => sum + weight, 0);
      root.style.height = `${Math.round(total * 48 + 100)}vh`;

      const scenes = weights.map((weight, index) => {
        const start = weights.slice(0, index).reduce((sum, value) => sum + value, 0);
        return { index, weight, start, end: start + weight };
      });

      let ticking = false;
      const update = () => {
        const scrollable = Math.max(root.offsetHeight - window.innerHeight, 1);
        const y = Math.min(Math.max(-root.getBoundingClientRect().top, 0), scrollable);
        const pos = (y / scrollable) * total;
        const imageFade = 0.55;
        const copyFade = 0.4;

        let active = 0;
        for (const scene of scenes) {
          if (pos < scene.end || scene.index === scenes.length - 1) {
            active = scene.index;
            break;
          }
        }
        showLeg(active);

        cards.forEach((card, index) => {
          const scene = scenes[index];
          let opacity = 1;
          if (pos < scene.start) opacity = Math.max(0, 1 - (scene.start - pos) / imageFade);
          else if (index !== scenes.length - 1 && pos > scene.end - imageFade) {
            opacity = Math.max(0, (scene.end - pos) / imageFade);
          }
          card.style.opacity = String(opacity);
          card.toggleAttribute("hidden", opacity < 0.04);

          let copyOpacity = opacity < 0.04 ? 0 : 1;
          if (index !== 0) copyOpacity = Math.min(copyOpacity, Math.max(0, (pos - scene.start) / copyFade));
          if (index !== scenes.length - 1) {
            copyOpacity = Math.min(copyOpacity, Math.max(0, (scene.end - imageFade - pos) / copyFade));
          }
          if (pos < scene.start || pos > scene.end) copyOpacity = 0;
          card.style.pointerEvents = copyOpacity > 0.7 ? "auto" : "none";
          const copy = card.querySelector<HTMLElement>(".flight-copy");
          if (copy) copy.style.opacity = String(copyOpacity);

          const plates = [...card.querySelectorAll<HTMLElement>(".flight-plate")];
          const local = Math.min(1, Math.max(0, (pos - scene.start) / scene.weight));
          const count = plates.length;
          const seg = 1 / count;
          const cursor = Math.min(local, 0.9999);
          const plateIndex = Math.min(count - 1, Math.floor(cursor / seg));
          const into = (cursor - plateIndex * seg) / seg;
          const fadeStart = 0.62;
          plates.forEach((plate, photoIndex) => {
            let plateOpacity = 0;
            if (count === 1) plateOpacity = 1;
            else if (photoIndex === plateIndex) {
              plateOpacity = plateIndex === count - 1 || into < fadeStart ? 1 : 1 - (into - fadeStart) / (1 - fadeStart);
            } else if (photoIndex === plateIndex + 1 && into >= fadeStart) {
              plateOpacity = (into - fadeStart) / (1 - fadeStart);
            }
            plate.style.opacity = String(plateOpacity);
            if (plateOpacity < 0.03) plate.setAttribute("hidden", "");
            else plate.removeAttribute("hidden");
            const image = plate.querySelector<HTMLElement>("img");
            if (image && plateOpacity > 0) {
              const drift = into - 0.5;
              const distance = Math.min(Math.abs(drift), 1);
              image.style.transform = `scale(${1.08 + (1 - distance) * 0.08}) translate3d(0, ${drift * -6}%, 0)`;
            }
          });
        });

        if (video) {
          const heroLocal = Math.min(1, Math.max(0, pos / scenes[0].weight));
          const videoOpacity = Math.max(0, 1 - heroLocal);
          video.style.opacity = String(videoOpacity);
          if (videoOpacity > 0.04 && video.readyState >= 1 && Number.isFinite(video.duration)) {
            const target = Math.min(video.duration - 0.05, heroLocal * video.duration);
            if (Math.abs(video.currentTime - target) > 0.12) video.currentTime = target;
          }
        }
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      update();
    }
  }
</script>
