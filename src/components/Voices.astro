---
import { careerLines, voices } from "../data/voices";
import { asset, page } from "../lib/urls";

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const shown = full ? voices : voices.slice(0, 3);
---

<section class="voices" id="voices" aria-labelledby="voices-title">
  <div class="wrap">
    <p class="eyebrow">Our students</p>
    <h2 id="voices-title">Students, in their own words</h2>
    <ul class="career-lines">
      {careerLines.map((line) => <li>{line}</li>)}
    </ul>
    <div class="voice-grid">
      {
        shown.map((voice) => (
          <figure class="voice-card">
            {
              voice.video && (
                <video controls preload="none" poster={voice.poster ? asset(voice.poster) : undefined}>
                  <source src={asset(voice.video)} type="video/mp4" />
                </video>
              )
            }
            <blockquote>
              <p>{voice.quote}</p>
            </blockquote>
            <figcaption>
              <cite>{voice.name}</cite> — {voice.when}
            </figcaption>
          </figure>
        ))
      }
    </div>
    {!full && <p><a class="btn btn-secondary" href={page("/voices/")}>All student voices</a></p>}
  </div>
</section>
