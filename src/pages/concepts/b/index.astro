---
import "@fontsource/newsreader/latin-600.css";
import "@fontsource/dm-sans/latin-400.css";
import "../../../styles/concept-b.css";
import Concept from "../../../layouts/Concept.astro";
import Switch from "../../../components/concepts/Switch.astro";
import { asset, page } from "../../../lib/urls";
---

<Concept
  klass="concept-b"
  title="Concept B · Keepers of the Land | Aboriginal Training Services"
  description="Design concept: a documentary academy told through land, water, and community photographs."
>
  <header class="b-bar">
    <a href={page("/concepts/b/")} style="color:#fff;text-decoration:none">
      <strong>Aboriginal Training Services</strong>
      <span>Keepers of the Land</span>
    </a>
    <nav aria-label="Concept B">
      <a href={page("/concepts/b/training/")}>Training</a>
      <a href={page("/contact/")}>Contact</a>
    </nav>
  </header>
  <main id="main">
    <section class="b-shot">
      <img
        src={asset("/media/aerial-river.webp")}
        alt="Drone view of the North Saskatchewan River, autumn trees, and the city beyond"
        width="1400"
        height="788"
      />
      <div class="veil" aria-hidden="true"></div>
      <div class="cap">
        <p class="eye">100% Indigenous owned and operated</p>
        <h1>Keepers of the Land.</h1>
        <p>We map it. Edmonton and Maskwacis. ATS with HK Drone Service.</p>
      </div>
    </section>
    <section class="b-shot">
      <img
        src={asset("/media/aerial-gathering.webp")}
        alt="Drone view of a community gathering on a riverbank field in Edmonton"
        width="1400"
        height="788"
      />
      <div class="veil" aria-hidden="true"></div>
      <div class="cap">
        <p class="eye">500+ students · Indigenous communities, government, industry</p>
        <h2>Keepers of the Data.</h2>
        <p>Maps and models that stay with the people who live on the land.</p>
      </div>
    </section>
    <section class="b-shot">
      <img
        src={asset("/media/field-winter.webp")}
        alt="Students and instructors with a multirotor on a winter prairie"
        width="1200"
        height="900"
      />
      <div class="veil" aria-hidden="true"></div>
      <div class="cap">
        <p class="eye">25+ Indigenous communities</p>
        <h2>Keepers of the Environment.</h2>
        <p>We protect it. We inspire the next generation.</p>
      </div>
    </section>
    <figure class="b-quote">
      <blockquote>As keepers of the land, we map it. We protect it. We inspire the next generation.</blockquote>
      <figcaption>Aboriginal Training Services and HK Drone Service</figcaption>
    </figure>
    <section class="b-links">
      <h2>The work</h2>
      <ul>
        <li><a href={page("/training/drone-pilot-certificate-basic-online/")}>Ground school <span>Basic</span></a></li>
        <li><a href={page("/training/flight-review-advanced-and-complex/")}>Flight review <span>Advanced</span></a></li>
        <li><a href={page("/training/rpas-lidar/")}>LiDAR <span>Applied</span></a></li>
        <li><a href={page("/concepts/b/training/")}>Training header <span>→</span></a></li>
      </ul>
    </section>
    <p class="b-note">
      TODO(owner): supply a verified Cree or other Indigenous-language line for this film. This concept does not invent one.
    </p>
    <footer class="b-foot">
      <span>Concept B · not the live home</span>
      <a href={page("/contact/")}>Free consultation</a>
    </footer>
    <Switch current="b" />
  </main>
</Concept>
