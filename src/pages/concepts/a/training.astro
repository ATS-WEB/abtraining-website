---
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../../../styles/concept-a.css";
import Concept from "../../../layouts/Concept.astro";
import Switch from "../../../components/concepts/Switch.astro";
import { courses } from "../../../data/courses";
import { asset, page } from "../../../lib/urls";
---

<Concept
  klass="concept-a"
  title="Concept A training header | Aboriginal Training Services"
  description="Night Sky Command training header concept."
>
  <header class="a-bar">
    <a class="a-brand" href={page("/concepts/a/")}>
      <img src={asset("/brand/logo.webp")} alt="" width="112" height="36" />
      Night Sky Command
    </a>
    <nav class="a-nav" aria-label="Concept A">
      <a href={page("/concepts/a/training/")} aria-current="page">Training</a>
      <a href={page("/services/")}>Services</a>
      <a href={page("/contact/")}>Contact</a>
    </nav>
  </header>
  <main id="main">
    <header class="a-pagehead">
      <p class="a-kicker">CMD / TRAINING · 100% Indigenous owned and operated</p>
      <h1>Training</h1>
    </header>
    <section class="a-train">
      <div class="a-panels">
        {
          courses.slice(0, 6).map((course, index) => (
            <a href={page(`/training/${course.slug}/`)}>
              <small>{String(index + 1).padStart(2, "0")}</small>
              <strong>{course.name}</strong>
            </a>
          ))
        }
      </div>
      <p><a href={page("/training/")}>Full catalog on the current site</a></p>
    </section>
    <Switch current="a" />
  </main>
</Concept>
