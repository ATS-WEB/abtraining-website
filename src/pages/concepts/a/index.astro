---
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../../../styles/concept-a.css";
import Concept from "../../../layouts/Concept.astro";
import Reel from "../../../components/concepts/Reel.astro";
import Switch from "../../../components/concepts/Switch.astro";
import { asset, page } from "../../../lib/urls";
---

<Concept
  klass="concept-a"
  title="Concept A · Night Sky Command | Aboriginal Training Services"
  description="Design concept: a dark cinematic academy with drone footage, telemetry, and the Keepers story."
>
  <header class="a-bar">
    <a class="a-brand" href={page("/concepts/a/")}>
      <img src={asset("/brand/logo.webp")} alt="" width="112" height="36" />
      Night Sky Command
    </a>
    <nav class="a-nav" aria-label="Concept A">
      <a href={page("/concepts/a/training/")} aria-current={undefined}>Training</a>
      <a href={page("/services/")}>Services</a>
      <a href={page("/contact/")}>Contact</a>
    </nav>
  </header>
  <main id="main">
    <section class="a-hero">
      <Reel />
      <div class="a-aurora" aria-hidden="true"></div>
      <div class="a-scrim" aria-hidden="true"></div>
      <div class="a-frame" aria-hidden="true"></div>
      <div class="a-copy">
        <p class="a-kicker">Edmonton · Maskwacis · ATS × HK Drone Service</p>
        <h1>100% Indigenous owned and operated.</h1>
        <p>Leading Indigenous Drone (RPAS) Academy. Keepers of the Land, the Data, and the Environment.</p>
        <div class="a-actions">
          <a class="a-go" href={page("/concepts/a/training/")}>Open training</a>
          <a class="a-line" href={page("/contact/")}>Free consultation</a>
        </div>
      </div>
    </section>
    <section class="a-readout" aria-label="Academy readout">
      <article>
        <span>01 · Land</span>
        <strong>Keepers of the Land</strong>
        <p>We map it. 25+ Indigenous communities served.</p>
      </article>
      <article>
        <span>02 · Data</span>
        <strong>Keepers of the Data</strong>
        <p>500+ students. Maps, models, and decisions that stay with the community.</p>
      </article>
      <article>
        <span>03 · Sky</span>
        <strong>Keepers of the Environment</strong>
        <p>We protect it, and we inspire the next generation.</p>
      </article>
    </section>
    <section class="a-train">
      <h2>Flight plan</h2>
      <div class="a-panels">
        <a href={page("/training/drone-pilot-certificate-basic-online/")}>
          <small>Ground school</small>
          <strong>Basic certificate</strong>
        </a>
        <a href={page("/training/flight-review-advanced-and-complex/")}>
          <small>Flight review</small>
          <strong>Advanced and Complex</strong>
        </a>
        <a href={page("/training/rpas-lidar/")}>
          <small>Applied</small>
          <strong>LiDAR</strong>
        </a>
        <a href={page("/training/rpas-greenhouse-gas-emissions/")}>
          <small>Applied</small>
          <strong>Methane and greenhouse gas</strong>
        </a>
      </div>
    </section>
    <p class="a-lang">
      TODO(owner): a verified Cree or other Indigenous-language line can sit here as the call sign. None is invented on this page.
    </p>
    <footer class="a-foot">
      <span>Concept A · not the live home</span>
      <a href={page("/concepts/a/training/")}>Training header</a>
    </footer>
    <Switch current="a" />
  </main>
</Concept>
