---
import Concept from "../../layouts/Concept.astro";
import { page } from "../../lib/urls";
---

<Concept
  klass="concept-a"
  title="Design concepts | Aboriginal Training Services"
  description="Three home-page directions for Aboriginal Training Services. Not the live home."
>
  <main id="main" style="padding:2rem 1.2rem;font-family:system-ui,sans-serif;background:#07111c;color:#e8f4fb;min-height:100vh">
    <p style="letter-spacing:.14em;text-transform:uppercase;font-size:.78rem">Choose a direction</p>
    <h1 style="font-size:clamp(2.4rem,6vw,4rem);letter-spacing:-.04em;max-width:12ch">Three ways to open the academy.</h1>
    <ul style="list-style:none;padding:0;display:grid;gap:.8rem;max-width:40rem">
      <li><a href={page("/concepts/a/")}>A · Night Sky Command</a></li>
      <li><a href={page("/concepts/b/")}>B · Keepers of the Land</a></li>
      <li><a href={page("/concepts/c/")}>C · Future Pathway</a></li>
      <li><a href={page("/")}>Current home</a></li>
    </ul>
  </main>
</Concept>
