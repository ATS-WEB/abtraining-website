---
import Base from "../layouts/Base.astro";
import { business, locations, mapsHref, phones } from "../config/site";
import { courses } from "../data/courses";

const description =
  "Contact Aboriginal Training Services in Edmonton and HK Drone Service in Maskwacis. Call +1 (403) 615-8083 or +1 (587) 524-0275, or email darcy@abtraining.ca.";
---

<Base title="Contact Aboriginal Training Services" description={description} path="/contact/">
  <section class="page-intro">
    <div class="wrap">
      <h1>Contact</h1>
      <p class="lead">
        Book a free consultation. Ask about a course date. Or plan a First Nation or group program
        with us. Group, organization, and capacity-building work is discounted.
      </p>
    </div>
  </section>
  <section class="section" style="padding-top:1rem">
    <div class="wrap contact-grid">
      <div class="contact-card">
        <h2>Edmonton and Maskwacis</h2>
        <ul>
          {
            locations.map((place) => (
              <li>
                <a href={mapsHref(place.maps)}>
                  {place.name}: {place.detail}
                </a>
              </li>
            ))
          }
        </ul>
        <ul>
          {
            phones.map((phone) => (
              <li>
                <a href={`tel:${phone.tel}`}>{phone.display}</a>
              </li>
            ))
          }
        </ul>
        <p>
          <a href={`mailto:${business.email}`}>{business.email}</a><br />
          <a href={`mailto:${business.partnerEmail}`}>{business.partnerEmail}</a>
        </p>
        <p>
          You can also email
          <a href={`mailto:${business.email}`}>{business.email}</a>
          and name the course.
        </p>
        <p>
          Already studying with us?
          <a href={business.studentPortal}>Sign in on Thinkific</a>.
        </p>
      </div>
      <form
        id="enquiry"
        class="contact-card"
        method="post"
        data-endpoint={business.formEndpoint}
        data-email={business.email}
      >
        <h2>Send an enquiry</h2>
        <p class="fine" id="form-help">
          {
            business.formEndpoint
              ? "Send this and we will reply by email."
              : "This opens your email app with your message ready to send. We read it when you send it."
          }
        </p>
        <label>
          Name
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          Email
          <input name="email" type="email" autocomplete="email" inputmode="email" required />
        </label>
        <label>
          Phone <span class="fine">(optional)</span>
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
        <label>
          Course
          <select id="course" name="course">
            <option value="">General enquiry</option>
            <option value="custom">Custom or community training</option>
            {courses.map((course) => <option value={course.slug}>{course.name}</option>)}
          </select>
        </label>
        <label>
          Message
          <textarea name="message" required minlength="10"></textarea>
        </label>
        <div class="hp" aria-hidden="true">
          <label>
            Company
            <input name="company" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <button class="btn btn-primary" type="submit">Send enquiry</button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const selected = params.get("course");
  const select = document.querySelector<HTMLSelectElement>("#course");
  if (selected && select?.querySelector(`option[value="${CSS.escape(selected)}"]`)) {
    select.value = selected;
  }

  const form = document.querySelector<HTMLFormElement>("#enquiry");
  const status = document.querySelector("#form-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form) return;
    const data = new FormData(form);
    if (String(data.get("company") || "").trim()) return;

    const payload = {
      name: String(data.get("name") || ""),
      email: String(data.get("email") || ""),
      phone: String(data.get("phone") || ""),
      course: String(data.get("course") || ""),
      message: String(data.get("message") || ""),
    };
    const endpoint = form.dataset.endpoint || "";
    const email = form.dataset.email || "";

    if (endpoint) {
      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        if (status) status.textContent = "Message sent. We will reply by email.";
      } catch {
        if (status) {
          status.textContent = `The form could not be sent. Email ${email} instead.`;
        }
      }
      return;
    }

    const courseLabel =
      select?.selectedOptions[0]?.textContent?.trim() || payload.course || "General enquiry";
    const subject = `Course enquiry: ${courseLabel}`;
    const body = [
      `Name: ${payload.name}`,
      `Email: ${payload.email}`,
      `Phone: ${payload.phone || "(not provided)"}`,
      `Course: ${courseLabel}`,
      "",
      payload.message,
    ].join("\n");
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    if (status) {
      status.textContent = `Your email app should open with this message. If it does not, email ${email} directly.`;
    }
  });
</script>
