---
import Base from "../layouts/Base.astro";
import { business } from "../config/site";
import { courses } from "../data/courses";
import { durationLabel } from "../lib/courses";
import { page } from "../lib/urls";

const regulation = courses.filter((course) => course.type === "Regulation");
const application = courses.filter((course) => course.type === "Application");
const description =
  "Transport Canada drone certificates, custom programs for First Nations and industry, and applied RPAS services from Aboriginal Training Services and HK Drone Service.";

const operations = [
  "Solar farm inspection",
  "Wind turbine inspections",
  "Remote mapping and surveying",
  "Remote fluid sampling",
  "Methane gas emission monitoring",
  "Heavy-lift drone logistics for construction",
  "Remote search and rescue",
  "Indigenous consultations",
  "Underwater search and rescue",
  "Underwater structure inspection",
  "Remote aerial gas sampling",
  "Remote oil and gas rig safety monitoring",
  "Remote oilsands and other energy infrastructure monitoring",
  "Remote mining site inspection and monitoring",
];

const custom = [
  "Apprenticeship programs",
  "Project-based programs",
  "Corporate training programs",
  "First Nation training programs",
  "Net-zero and zero-emission training programs",
  "Group training programs",
  "Organization drone programs",
  "First Nation service agreements",
  "Capacity building programs",
];
---

<Base title="Training and Drone Services" description={description} path="/services/">
  <section class="page-intro">
    <div class="wrap">
      <p class="eyebrow">ATS and {business.partnerName}</p>
      <h1>Services</h1>
      <p class="lead">
        A full-service offer, as the portfolio states it: hardware, training, operations, and data
        analytics. DJI Authorized Dealer, plus custom Canadian solutions. Free consultation.
      </p>
    </div>
  </section>

  <section class="section" id="certification">
    <div class="wrap">
      <div class="section-head">
        <h2>Transport Canada drone certificate training</h2>
        <p>Basic, Advanced, Level 1 Complex, and flight reviews. Online where a checkout exists.</p>
      </div>
      <div class="service-grid">
        {
          regulation.map((course) => (
            <article class="service-card">
              <h3>
                <a href={page(`/training/${course.slug}/`)}>{course.name}</a>
              </h3>
              <p>
                {durationLabel(course)} · {course.format === "online" ? "Online" : "In person"} ·{" "}
                {course.level}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="applications" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Hands-on application training</h2>
        <p>
          Environmental monitoring, search and rescue, inspection, mapping and surveying, LiDAR,
          greenhouse gas, methane monitoring, water sampling, and agriculture.
        </p>
      </div>
      <div class="service-grid">
        {
          application.map((course) => (
            <article class="service-card">
              <h3>
                <a href={page(`/training/${course.slug}/`)}>{course.name}</a>
              </h3>
              <p>
                {durationLabel(course)} · {course.level}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="communities" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Custom programs</h2>
        <p>
          Discounts are offered for group training, organization drone programs, First Nation
          service agreements, and capacity building. Book a free consultation for dates and price.
        </p>
      </div>
      <ul class="chip-row">
        {custom.map((item) => <li class="chip">{item}</li>)}
      </ul>
      <p>
        <a class="btn btn-primary" href={page("/contact/?course=custom")}>Plan a custom course</a>
      </p>
    </div>
  </section>

  <section class="section" id="operations" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Drone services with HK</h2>
        <p>
          Core services printed in the ATS and HK brochure. These are operations, not courses with
          a public checkout. Ask {business.partnerName} or the academy for a consultation.
        </p>
      </div>
      <ul class="checklist">
        {operations.map((item) => <li>{item}</li>)}
      </ul>
      <h3>Signature aircraft in the portfolio</h3>
      <p>
        The portfolio describes an eVTOL called KISIK: 3-hour endurance, 200 km BVLOS range,
        designed and engineered in Canada, Indigenous-led research for environmental stewardship,
        and described as Transport Canada compliant and remote-territory optimized. A photograph of
        the aircraft was not in the files, so none is shown.
      </p>
      <p>
        <a class="btn btn-secondary" href={business.partnerUrl}>HK Drone Service</a>
        <a class="btn btn-primary" href={page("/contact/")}>Ask about a service</a>
      </p>
    </div>
  </section>
</Base>
