---
import Base from "../layouts/Base.astro";
import { business } from "../config/site";
import { courses } from "../data/courses";
import { durationLabel } from "../lib/courses";
import { page } from "../lib/urls";

const regulation = courses.filter((course) => course.type === "Regulation");
const application = courses.filter((course) => course.type === "Application");
const description =
  "Transport Canada drone certificates, custom programs for First Nations and industry, and RPAS services we fly with HK Drone Service.";

const custom = [
  "Apprenticeship programs",
  "Project-based programs",
  "Corporate training programs",
  "First Nation training programs",
  "Net-zero and zero-emission training programs",
  "Group training programs",
  "Organization drone programs",
  "First Nation service agreements",
  "Capacity building programs",
];
---

<Base title="Training and Drone Services" description={description} path="/services/">
  <section class="page-intro">
    <div class="wrap">
      <p class="eyebrow">ATS and {business.partnerName}</p>
      <h1>Services</h1>
      <p class="lead">
        We cover the hardware, the training, the flying, and the data that comes back. We are a DJI
        Authorized Dealer, and we build custom Canadian solutions. The first conversation is free.
      </p>
    </div>
  </section>

  <section class="section" id="certification">
    <div class="wrap">
      <div class="section-head">
        <h2>Transport Canada drone certificate training</h2>
        <p>
          Basic, Advanced, Level 1 Complex, and flight reviews. Register online when a course is
          open. For the rest, we will set a date with you.
        </p>
      </div>
      <div class="service-grid">
        {
          regulation.map((course) => (
            <article class="service-card">
              <h3>
                <a href={page(`/training/${course.slug}/`)}>{course.name}</a>
              </h3>
              <p>
                {durationLabel(course)} · {course.format === "online" ? "Online" : "In person"} ·{" "}
                {course.level}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="applications" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Hands-on application training</h2>
        <p>
          After the certificate, we teach the job: environmental monitoring, search and rescue,
          inspection, mapping and surveying, LiDAR, greenhouse gas and methane, water sampling, and
          agriculture.
        </p>
      </div>
      <div class="service-grid">
        {
          application.map((course) => (
            <article class="service-card">
              <h3>
                <a href={page(`/training/${course.slug}/`)}>{course.name}</a>
              </h3>
              <p>
                {durationLabel(course)} · {course.level}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="communities" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Custom programs</h2>
        <p>
          We build the program around your people. Group training, organization programs, First
          Nation service agreements, and capacity building are discounted. Tell us the dates and we
          will talk about price.
        </p>
      </div>
      <ul class="chip-row">
        {custom.map((item) => <li class="chip">{item}</li>)}
      </ul>
      <p>
        <a class="btn btn-primary" href={page("/contact/?course=custom")}>Plan a custom course</a>
      </p>
    </div>
  </section>

  <section class="section" id="operations" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Flying with HK Drone Service</h2>
        <p>
          These are jobs we take on with HK, not courses you buy online. Call us or HK and we will
          talk it through.
        </p>
      </div>
      <p>
        We inspect solar farms and wind turbines. We map and survey remote sites. We sample fluids
        from a distance, sample gases from the air, and monitor methane emissions. We monitor
        safety on oil and gas rigs, oilsands and other energy sites, and remote mines.
      </p>
      <p>
        We fly search and rescue. We search underwater, and we inspect underwater structures. We
        move construction loads with heavy-lift aircraft. We support Indigenous consultations.
      </p>
      <h3>KISIK</h3>
      <p>
        KISIK is an eVTOL designed and engineered in Canada for remote territory. Three hours of
        endurance. Two hundred kilometres beyond visual line of sight. The research is
        Indigenous-led, for environmental stewardship, and the aircraft is Transport Canada
        compliant.
      </p>
      <p>
        <a class="btn btn-secondary" href={business.partnerUrl}>HK Drone Service</a>
        <a class="btn btn-primary" href={page("/contact/")}>Ask about a service</a>
      </p>
    </div>
  </section>
</Base>
