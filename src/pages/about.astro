---
import Base from "../layouts/Base.astro";
import { business, portfolioPartners, publishedStats } from "../config/site";
import { asset, page } from "../lib/urls";

const description =
  "We are a 100% Indigenous owned and operated RPAS academy in Edmonton, in partnership with HK Drone Service.";
---

<Base title="About the Academy" description={description} path="/about/">
  <section class="page-intro">
    <div class="wrap prose">
      <p class="eyebrow">{business.positioning}</p>
      <h1>About Aboriginal Training Services and HK Drone Service</h1>
      <p class="lead">
        We are a 100% Indigenous owned and operated academy. Together with HK Drone Service, we are
        a leading Indigenous aerospace company: leaders and champions of RPAS technology and
        innovation.
      </p>
      <p>
        We advocate, encourage, and unite Indigenous people and communities to lead the drone
        industry.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem">
    <div class="wrap">
      <ul class="stats">
        {
          publishedStats.map((stat) => (
            <li class="stat">
              <b>{stat.value}</b>
              <span>{stat.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="fine" style="margin-top:0.8rem">
        Students give us a {business.googleRating} on Google, across {business.googleReviewCount} reviews.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap photo-grid two">
      <figure>
        <img
          src={asset("/media/classroom-crew.webp")}
          alt="People seated in a classroom for RPAS regulation training"
          width="1100"
          height="514"
          loading="lazy"
        />
        <figcaption>Regulation training with the Indian Resource Council of Canada.</figcaption>
      </figure>
      <figure>
        <img
          src={asset("/media/flight-line.webp")}
          alt="Pilots with controllers beside a multirotor on a marked pad"
          width="800"
          height="600"
          loading="lazy"
        />
        <figcaption>Practice on the flight line, outside the academy.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap value-grid">
      <article class="value-card">
        <h2>Vision</h2>
        <p>
          In Indigenous communities, we are raising leaders, innovators, entrepreneurs, and strong
          youth. We mean to lead the Canadian RPAS industry and to prepare Indigenous entrepreneurs.
          In aviation, renewable energy, and clean technology, our people are the CEOs, presidents,
          and owners.
        </p>
      </article>
      <article class="value-card">
        <h2>Mission</h2>
        <p>
          We train and prepare you. That means individuals, organizations, First Nation people, and
          communities.
        </p>
      </article>
      <article class="value-card">
        <h2>The line we work by</h2>
        <p>
          “As keepers of the land, we map it. We protect it. We inspire the next generation.”
        </p>
        <p>What we are after is jobs, skills, self-determination, and care for the environment.</p>
      </article>
      <article class="value-card">
        <h2>Edmonton and Maskwacis</h2>
        <p>
          Our headquarters is in Edmonton. HK Drone Service is in Maskwacis. Ground school has
          trained students in Indigenous communities, and in government, commercial, and industrial
          work.
        </p>
      </article>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap prose">
      <h2>Who we work with</h2>
      <p>
        We are glad to name these organizations. Ask us what we do with any of them.
      </p>
      <ul>
        {portfolioPartners.map((name) => <li>{name}</li>)}
      </ul>
      <p>
        We are a DJI Authorized Dealer. We hold active contracts in environmental monitoring and
        the resource sector. We train with NAIT and Northquest College. The Indigenous Business
        Canada ecosystem recognizes this work.
      </p>
      <p>
        <a href={page("/blog/flying-higher-ats-nait-partnership/")}>Read the NAIT partnership story</a>
      </p>
      <h2>The people students talk about</h2>
      <p>
        Students name the people who taught them: Darcy, Olaolu (Ola), Chris, Magid, Milly, and
        Lena.
      </p>
      <p>
        <a class="btn btn-primary" href={page("/contact/")}>Book a free consultation</a>
      </p>
    </div>
  </section>
</Base>
