---
import Base from "../layouts/Base.astro";
import { page } from "../lib/urls";
---

<Base
  title="Page not found"
  description="We can't find that page. Head home, or look through the courses."
  path="/404/"
  noindex={true}
>
  <section class="page-intro">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lead">We can't find that page. Head home, or look through the courses.</p>
      <div class="actions">
        <a class="btn btn-primary" href={page("/")}>Home</a>
        <a class="btn btn-secondary" href={page("/training/")}>Training courses</a>
      </div>
    </div>
  </section>
</Base>
