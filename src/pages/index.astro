---
import Flight from "../components/Flight.astro";
import Quiz from "../components/Quiz.astro";
import Voices from "../components/Voices.astro";
import WorkMap from "../components/WorkMap.astro";
import Base from "../layouts/Base.astro";
import "../styles/experience.css";
import { page } from "../lib/urls";

const description =
  "A 100% Indigenous owned and operated RPAS Academy. Indigenous-led. Sky-ready. Edmonton and Maskwacis, with HK Drone Service.";
---

<Base
  title="Aboriginal Training Services | A 100% Indigenous owned and operated RPAS Academy"
  description={description}
  path="/"
  overlay={true}
>
  <Flight />
  <Quiz />
  <WorkMap />
  <Voices />
  <section class="cta-band">
    <div class="wrap">
      <h2>Training for the future.</h2>
      <p>Ground school is open online. Everything else starts with a conversation.</p>
      <div class="actions">
        <a class="btn btn-copper" href={page("/training/")}>All courses</a>
        <a class="btn btn-on-dark" href={page("/contact/")}>Free consultation</a>
      </div>
    </div>
  </section>
</Base>
