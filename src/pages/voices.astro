---
import Voices from "../components/Voices.astro";
import Base from "../layouts/Base.astro";
import "../styles/experience.css";

const description =
  "Google reviews from students of Aboriginal Training Services, in their own words.";
---

<Base title="Student voices" description={description} path="/voices/">
  <section class="page-intro">
    <div class="wrap">
      <h1>Voices from the academy</h1>
      <p class="lead">
        We are 100% Indigenous owned and operated. These are Google reviews from our students.
      </p>
    </div>
  </section>
  <Voices full={true} />
</Base>
