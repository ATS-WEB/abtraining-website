---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatIsoDate } from "../../lib/courses";
import { page } from "../../lib/urls";

const posts = (await getCollection("blog")).sort((a, b) =>
  a.data.date < b.data.date ? 1 : -1,
);
const description =
  "Stories from Aboriginal Training Services: the NAIT partnership, community drone training, and notes from the RPAS industry.";
---

<Base title="Blog" description={description} path="/blog/">
  <section class="page-intro">
    <div class="wrap">
      <h1>Blog</h1>
      <p class="lead">
        Notes and stories published by Aboriginal Training Services. Each post keeps the summary
        that was public on the previous site.
      </p>
    </div>
  </section>
  <section class="section" style="padding-top:1rem">
    <div class="wrap post-grid">
      {
        posts.map((post) => (
          <article class="post-card">
            <time datetime={post.data.date}>{formatIsoDate(post.data.date)}</time>
            <h2>
              <a href={page(`/blog/${post.id}/`)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <a href={page(`/blog/${post.id}/`)}>Read story</a>
          </article>
        ))
      }
    </div>
  </section>
</Base>
