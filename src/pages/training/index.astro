---
import CourseCard from "../../components/CourseCard.astro";
import Base from "../../layouts/Base.astro";
import { courses } from "../../data/courses";
import { courseCounts } from "../../lib/courses";
import { canonical } from "../../lib/urls";

const description =
  "Twelve RPAS courses from Aboriginal Training Services: Transport Canada exam prep, flight reviews, and applied training in mapping, LiDAR, thermal, and more.";

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "RPAS training courses",
  itemListElement: courses.map((course, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: course.name,
    url: canonical(`/training/${course.slug}/`),
  })),
};
---

<Base
  title="RPAS Training Courses"
  description={description}
  path="/training/"
  jsonLd={[itemList]}
>
  <section class="page-intro">
    <div class="wrap">
      <h1>Training courses</h1>
      <p class="lead">
        Programs for people starting out, pilots moving into advanced operations, and crews who
        need mapping, sensing, or search skills. Prices are in Canadian dollars when a CAD price
        is confirmed. Otherwise you can still register or send an enquiry.
      </p>
      <div class="filters" role="group" aria-label="Filter courses">
        <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">
          All courses ({courseCounts.all})
        </button>
        <button class="filter-btn" type="button" data-filter="Regulation" aria-pressed="false">
          Regulation ({courseCounts.regulation})
        </button>
        <button class="filter-btn" type="button" data-filter="Application" aria-pressed="false">
          Application ({courseCounts.application})
        </button>
      </div>
      <p id="filter-status" aria-live="polite">Showing {courseCounts.all} courses.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0.5rem">
    <div class="wrap">
      <div class="course-grid catalog">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-type]");
  const status = document.querySelector("#filter-status");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter ?? "all";
      buttons.forEach((item) => {
        item.setAttribute("aria-pressed", item === button ? "true" : "false");
      });
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === "all" || card.dataset.type === filter;
        card.hidden = !match;
        if (match) shown += 1;
      });
      if (status) {
        const label = filter === "all" ? "courses" : `${filter.toLowerCase()} courses`;
        status.textContent = `Showing ${shown} ${label}.`;
      }
    });
  });
</script>
