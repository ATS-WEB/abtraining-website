---
import Base from "../layouts/Base.astro";
import { business } from "../config/site";
import { page } from "../lib/urls";

const description =
  "Indigenous-led drone work from our academy and HK Drone Service. We map the land, care for the data, and train communities to do this work.";
---

<Base title="Indigenous Relations" description={description} path="/indigenous-relations/">
  <section class="page-intro">
    <div class="wrap prose">
      <p class="eyebrow">Indigenous-led</p>
      <h1>Technology in service of the land</h1>
      <p class="lead">
        We are keepers of the land, the data, and the environment. The flying is Indigenous-led. We
        map the land, and we protect it.
      </p>
      <p>
        “We are keepers of the land using modern tools to fulfill our responsibility.”
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0.4rem">
    <div class="wrap keepers">
      <article class="keeper">
        <h2>Keepers of the Land</h2>
        <p>
          We put data in the hands of the people who decide: resource management, environmental
          monitoring, and forestry.
        </p>
      </article>
      <article class="keeper">
        <h2>Keepers of the Data</h2>
        <p>We map so you can see the land clearly, including 3D models and 2D maps.</p>
      </article>
      <article class="keeper">
        <h2>Keepers of the Environment</h2>
        <p>
          We protect by mapping. Wildlife habitat, erosion, environmental change, regulatory
          compliance, and the care of the land.
        </p>
      </article>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap prose">
      <h2>Where we are headed</h2>
      <ul>
        <li>We are training the workforce that will fly this work.</li>
        <li>We train Indigenous communities to lead a green-energy future.</li>
        <li>We bring people and technology together, and we protect the environment while we do it.</li>
        <li>We back Indigenous people who want to champion clean technology.</li>
      </ul>
      <p>
        Commercial flying needs a Transport Canada certificate. Without one, communities miss
        chances in land consultation, emergency response, and environmental monitoring. We see the
        drone as a reconciliation tool, for Treaty rights and self-determination.
      </p>
      <h2>How we reach communities</h2>
      <p>
        Our ground school has trained more than 500 students, in Indigenous communities and in
        government, commercial, and industrial work. We have served more than 25 Indigenous
        communities across Canada, with First Nation service agreements.
      </p>
      <p>
        We also build First Nation training programs, First Nation service agreements, and
        capacity-building programs. Those programs are discounted.
      </p>
    </div>
  </section>

  {
    business.landAcknowledgement ? (
      <section class="section" id="land-acknowledgement" style="padding-top:0">
        <div class="wrap ack-slot">
          <h2>Land acknowledgement</h2>
          <p>{business.landAcknowledgement}</p>
        </div>
      </section>
    ) : null
  }

  <section class="cta-band">
    <div class="wrap">
      <h2>Talk about training on your territory</h2>
      <p>First Nation service agreements and capacity-building programs start with a conversation.</p>
      <div class="actions">
        <a class="btn btn-copper" href={page("/contact/")}>Start a conversation</a>
        <a class="btn btn-on-dark" href={page("/training/")}>Explore training</a>
      </div>
    </div>
  </section>
</Base>
